root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true

[*.{c,h,y}{,.in}]
indent_style = tab
tab_width = 8
indent_size = tab
trim_trailing_whitespace = true
charset = utf-8
max_line_length = 72

[*.py{,.in}]
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
charset = utf-8

[{CMakeLists.txt,*.cmake}{,.in}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[{monetdb5,sql}/**.{c,h,y}{,.in}]
tab_width = 4
max_line_length = 120

[*.yml]
indent_style = space
indent_size = 2
