statement ok
CREATE TABLE ctas_bug (
    c1 INT PRIMARY KEY,
    c2 VARCHAR(20),
    c4 INT,
    c6 VARCHAR(10)
)

statement ok rowcount 4
INSERT INTO ctas_bug VALUES
    (1, 'a', 10, 'x'),
    (2, 'b', 20, 'y'),
    (3, 'c', 30, 'z'),
    (4, 'd', 40, 'w')

query I nosort
SELECT COUNT(*)
FROM (
    SELECT (c1 / NULLIF(c1, 0)) AS x,
           COUNT(DISTINCT c4) AS y,
           c6 AS z
    FROM ctas_bug
    WHERE c1 < 4
    GROUP BY (c1 / NULLIF(c1, 0)), c1, c6
) AS q
----
3

query IIT nosort
