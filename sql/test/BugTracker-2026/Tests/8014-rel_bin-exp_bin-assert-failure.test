statement ok
CREATE TEMPORARY TABLE ctas_bug_tmp AS
SELECT (c1 / NULLIF(c1, 0)) AS x,
       COUNT(DISTINCT c4) AS y,
       c6 AS z
FROM ctas_bug
WHERE c1 < 4
GROUP BY (c1 / NULLIF(c1, 0)), c1, c6
ON COMMIT PRESERVE ROWS

query I nosort
SELECT COUNT(*) FROM ctas_bug_tmp
----
3

