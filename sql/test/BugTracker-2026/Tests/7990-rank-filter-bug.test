-- query without the WHERE r <= 1 works fine
query III rowsort
WITH t(id,x) AS (
  VALUES (1,10), (2,10), (3,20), (4,30)
)
SELECT id, x, r
FROM (
  SELECT id, x, RANK() OVER (ORDER BY x) AS r
  FROM t
) AS s
-- WHERE r <= 1
ORDER BY id
----
1
10
1
2
10
1
3
20
3
4
30
4

-- query with the WHERE r <= 1 works incorrect (removes row {2,10,1})
query III rowsort
WITH t(id,x) AS (
  VALUES (1,10), (2,10), (3,20), (4,30)
)
SELECT id, x, r
FROM (
  SELECT id, x, RANK() OVER (ORDER BY x) AS r
  FROM t
) AS s
WHERE r <= 1
ORDER BY id
----
1
10
1
2
10
1

