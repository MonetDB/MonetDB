-- and triggers assert failure: sql/backends/monet5/rel_bin.c:1914: exp_bin: Assertion `s' failed.
-- An identity derived table must not remove the grouped result.
query II nosort
SELECT input.k, SUM(DISTINCT input.v)
FROM (
    SELECT k, v
    FROM t8019
) AS input
GROUP BY input.k
----
1
5

-- next statement triggers assert failure: sql/backends/monet5/rel_bin.c:1914: exp_bin: Assertion `s' failed.
