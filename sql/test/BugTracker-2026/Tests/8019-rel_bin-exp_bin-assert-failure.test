CREATE TABLE t8019_ctas AS
SELECT input.k, SUM(DISTINCT input.v) AS s
FROM (
    SELECT k, v
    FROM t8019
) AS input
GROUP BY input.k

query II nosort
SELECT k, s FROM t8019_ctas
----
