-- INNER JOIN: all next INNER JOIN queries should return no rows

query I rowsort
SELECT t2.c0
FROM t0 INNER JOIN t2 ON t0.c0 = t2.c0
----

query I rowsort
SELECT t2.c0
FROM t0 INNER JOIN t2 ON t0.c0 = t2.c0
GROUP BY t2.c0
----

-- Q1  DQR base: issue: HAVING keeps the phantom NULL group
query I rowsort
SELECT t2.c0
FROM t0 INNER JOIN t2 ON t0.c0 = t2.c0
GROUP BY t2.c0
HAVING MIN(t2.c0) IS NOT NULL
----

-- Q2  DQR moved: same boolean as ref1
query I rowsort
SELECT ref0 FROM (
  SELECT t2.c0 AS ref0, (MIN(t2.c0) IS NOT NULL) AS ref1
  FROM t0 INNER JOIN t2 ON t0.c0 = t2.c0
  GROUP BY t2.c0
) AS s WHERE ref1
----

