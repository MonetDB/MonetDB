statement ok
CREATE TABLE t1 (id INT PRIMARY KEY, c0 INT)

statement ok rowcount 6
INSERT INTO t1 VALUES (1, 10), (2, 10), (3, 10), (4, 20), (5, 20), (6, 30)

statement ok
CREATE TABLE t2 (id INT PRIMARY KEY, c0 INT, c1 INT)

statement ok rowcount 9
INSERT INTO t2 VALUES (1, 10, 1), (2, 10, 1), (3, 20, 1), (4, 20, 1), (5, 20, 1), (6, 30, 1), (7, 30, 1), (8, 30, 1), (9, 30, 1)

# Baseline query (returns expected counts):
query II
SELECT o.id,
       (SELECT COUNT(*) FROM t2 x
        WHERE x.c0 = o.c0 OR 1 = 0) AS n
FROM t1 o
ORDER BY o.id
----
1	2
2	2
3	2
4	3
5	3
6	4


# Variant query (returns 9 for all rows):
query II
SELECT o.id,
       (SELECT COUNT(*) FROM t2 x
        WHERE (NOT (x.c0 <> o.c0)) OR 1 = 0) AS n
FROM t1 o
ORDER BY o.id
----
1	2
2	2
3	2
4	3
5	3
6	4
