query ITT rowsort
SELECT id,
  GROUP_CONCAT(s ORDER BY s) OVER (
    ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING
  ) AS actual,
  (SELECT GROUP_CONCAT(r.s ORDER BY r.s) FROM t8003 r) AS expected
FROM t8003
ORDER BY id
