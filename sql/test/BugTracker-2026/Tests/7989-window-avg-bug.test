query IRR rowsort
WITH t AS (
  SELECT value AS id, CAST(value - 1 AS DOUBLE) AS v
  FROM generate_series(1, 18)
)
SELECT id,
       AVG(v) OVER (
         ORDER BY id
         ROWS BETWEEN 16 PRECEDING AND CURRENT ROW
       ) AS actual,
       (SELECT AVG(r.v) FROM t AS r WHERE r.id <= t.id) AS expected
FROM t
ORDER BY id
