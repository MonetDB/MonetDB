query IIII rowsort
SELECT id, k,
  COUNT(v) OVER (
    ORDER BY k
    RANGE BETWEEN CURRENT ROW AND CURRENT ROW
  ) AS actual,
  (SELECT COUNT(r.v) FROM t7982 r WHERE r.k = t7982.k) AS expected
FROM t7982
ORDER BY id
