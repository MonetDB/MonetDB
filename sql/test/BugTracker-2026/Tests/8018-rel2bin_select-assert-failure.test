CREATE VIEW v8018 AS
SELECT flagged.b, flagged.x
FROM (
    SELECT (ranked.x IN (SELECT 1)) AS b,
           ranked.x
    FROM (
        SELECT x, ROW_NUMBER() OVER () AS rn
        FROM t8018
    ) AS ranked
    WHERE ranked.rn > 1
) AS flagged
WHERE flagged.b = TRUE

