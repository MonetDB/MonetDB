-- HANGS (never returns; EXPLAIN above returns instantly):
query I nosort
SELECT COUNT(*) FROM n3a
 WHERE n3a.c0 = 999999
   AND EXISTS (SELECT 1 FROM n3b WHERE n3b.c0 = n3a.c0)
 GROUP BY ROLLUP(n3a.c1)
----
0

-- The IN form hangs identically (semi-join, not EXISTS-specific):
query I nosort
SELECT COUNT(*) FROM n3a
 WHERE n3a.c0 = 999999
   AND n3a.c0 IN (SELECT n3b.c0 FROM n3b)
 GROUP BY ROLLUP(n3a.c1)
----
0

-- remove the provably-empty selection (c0 = 10 instead of 999999):
query I nosort
SELECT COUNT(*) FROM n3a WHERE n3a.c0 = 10
   AND EXISTS (SELECT 1 FROM n3b WHERE n3b.c0 = n3a.c0)
 GROUP BY ROLLUP(n3a.c1)                                   -- returns 1, 1
----
1
1

-- remove the EXISTS subquery:
query I nosort
SELECT COUNT(*) FROM n3a WHERE n3a.c0 = 999999
 GROUP BY ROLLUP(n3a.c1)                                   -- returns 0
----
0

-- remove the ROLLUP (plain GROUP BY):
query I nosort
SELECT COUNT(*) FROM n3a WHERE n3a.c0 = 999999
   AND EXISTS (SELECT 1 FROM n3b WHERE n3b.c0 = n3a.c0)
 GROUP BY n3a.c1                                           -- returns empty
