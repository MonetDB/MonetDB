query I nosort
SELECT c0
 FROM t8026
GROUP BY c0
HAVING (c0 = 0) OR NOT (c0 = 1 AND c0 IS NOT NULL)
----
100

-- projection path (correct)
query I nosort
SELECT ref0 FROM (
  SELECT c0 AS ref0,
         (c0 = 0) OR NOT (c0 = 1 AND c0 IS NOT NULL) AS ref1
  FROM t8026
  GROUP BY c0
) AS s WHERE ref1
----
100


