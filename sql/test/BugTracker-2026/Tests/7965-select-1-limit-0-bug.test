-- Failing query when using LIMIT 0
query I nosort
SELECT 1 LIMIT 0
----

-- Control query: succeeds and returns an empty result set.
query I nosort
SELECT 1 ORDER BY 1 LIMIT 0
----

-- query succeeds when using LIMIT 1
query I nosort
SELECT 1 LIMIT 1
----
1



-- Failing query when using VALUES and LIMIT 0
query I nosort
SELECT * FROM (VALUES (1)) AS v(x) LIMIT 0
----

-- Control query using VALUES: succeeds and returns an empty result set.
query I nosort
SELECT * FROM (VALUES (1)) AS v(x) ORDER BY x LIMIT 0
----

-- query succeeds when using VALUES and LIMIT 1.
query I nosort
SELECT * FROM (VALUES (1)) AS v(x) LIMIT 1
----
1

