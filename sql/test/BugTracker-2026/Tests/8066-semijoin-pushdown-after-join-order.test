# the semijoin created after join_order must be pushed below the b/a join
query T
EXPLAIN SELECT COUNT(*) FROM b8066 JOIN c8066 ON b8066.id = c8066.id JOIN a8066 ON b8066.low_key = a8066.low_key
----
project (
| group by (
| | join (
| | | semijoin (
| | | | table("sys"."b8066") [ "b8066"."id", "b8066"."low_key" ],
| | | | table("sys"."c8066") [ "c8066"."id" ]
| | | ) [ ("b8066"."id") = ("c8066"."id") ],
| | | table("sys"."a8066") [ "a8066"."low_key" ]
| | ) [ ("b8066"."low_key") = ("a8066"."low_key") ]
| ) [  ] [ "sys"."count"() as "%1"."%1" ]
) [ "%1"."%1" ]

query I
SELECT COUNT(*) FROM b8066 JOIN c8066 ON b8066.id = c8066.id JOIN a8066 ON b8066.low_key = a8066.low_key
