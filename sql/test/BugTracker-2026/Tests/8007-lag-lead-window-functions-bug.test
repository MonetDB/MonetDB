query IIIIII rowsort
SELECT
  g,
  id,
  LAG(x, 1, d) OVER (PARTITION BY g ORDER BY id) AS lag_actual,
  CASE WHEN id = 1 THEN d ELSE x - 10 END AS lag_expected,
  LEAD(x, 1, d) OVER (PARTITION BY g ORDER BY id) AS lead_actual,
  CASE WHEN id = 1 THEN x + 10 ELSE d END AS lead_expected
FROM lag_lead_default_expr_bug
ORDER BY g, id
