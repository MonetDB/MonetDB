query TIIIII rowsort
WITH t(p, id, v) AS (VALUES ('a', 1, 10), ('a', 2, 20), ('a', 3, 30), ('b', 4, 7), ('b', 5, 11))
SELECT p, id,
  FIRST_VALUE(v) OVER (PARTITION BY p RANGE BETWEEN CURRENT ROW AND CURRENT ROW) AS actual_first,
  LAST_VALUE(v) OVER (PARTITION BY p RANGE BETWEEN CURRENT ROW AND CURRENT ROW) AS actual_last,
  FIRST_VALUE(v) OVER (PARTITION BY p RANGE BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) AS full_first_control,
  LAST_VALUE(v) OVER (PARTITION BY p RANGE BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) AS full_last_control
FROM t ORDER BY id
