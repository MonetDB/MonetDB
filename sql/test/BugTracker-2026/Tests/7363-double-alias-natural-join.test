# The duplicate aliases must not produce a duplicate join equality.
query T nosort
EXPLAIN SELECT * FROM (SELECT n n1, n n2, c FROM f7363) AS fs NATURAL JOIN (SELECT n n1, n n2, c FROM b7363) AS bs
----
project (
| join (
| | project (
| | | table("sys"."f7363") [ "f7363"."n", "f7363"."c" ]
| | ) [ "f7363"."n" as "fs"."n1", "fs"."n1" as "fs"."n2", "f7363"."c" as "fs"."c" ],
| | project (
| | | table("sys"."b7363") [ "b7363"."n", "b7363"."c" ]
| | ) [ "b7363"."n" as "bs"."n1", "b7363"."c" as "bs"."c" ]
| ) [ ("fs"."n1") = ("bs"."n1"), ("fs"."c") = ("bs"."c") ]
) [ "fs"."n1", "fs"."n2", "fs"."c" ]

query III nosort
