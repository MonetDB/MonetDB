statement ok
CREATE SEQUENCE seq1_8049 AS INT;

statement ok
CREATE SEQUENCE seq2_8049 AS INT;

statement ok
CREATE TABLE t1_8049(val VARCHAR);

statement ok
ALTER TABLE t1_8049 ADD COLUMN id INT DEFAULT NEXT VALUE FOR seq1_8049;

statement ok
CREATE TABLE t2_8049(id INT DEFAULT NEXT VALUE FOR seq2_8049, val VARCHAR);

# ADD COLUMN must register the same dependency as CREATE TABLE
query TTI rowsort
SELECT master.name, slave.name, d.depend_type
FROM sys.dependencies d
    LEFT JOIN sys.ids master ON master.id = d.id
    LEFT JOIN sys.ids slave ON slave.id = d.depend_id
WHERE master.name IN ('seq1_8049', 'seq2_8049')
----
seq1_8049
t1_8049
7
seq2_8049
t2_8049
7

# the sequence cannot be dropped while the table depends on it
statement error /there are database objects which depend on it/
DROP SEQUENCE seq1_8049;

# inserts still work
statement ok
INSERT INTO t1_8049(val) VALUES ('a');

query TII
SELECT val, id, id FROM t1_8049
----
a
1
1

# a function used as a column default is tracked as well
statement ok
CREATE FUNCTION fdef_8049(x INT) RETURNS INT BEGIN RETURN x + 1; END;

statement ok
CREATE TABLE t3_8049(val VARCHAR);

statement ok
ALTER TABLE t3_8049 ADD COLUMN id INT DEFAULT fdef_8049(5);

query TTT
SELECT f.name, i.name, d.depend_type
FROM sys.dependencies d
    JOIN sys.functions f ON f.id = d.id
    JOIN sys.ids i ON i.id = d.depend_id
WHERE f.name = 'fdef_8049'
----
fdef_8049
t3_8049
7

statement error /there are database objects dependent on/
DROP FUNCTION fdef_8049(INT);

# an identity column gets its BEDROPPED_DEPENDENCY, not a table dependency
statement ok
CREATE TABLE t4_8049(val VARCHAR);

statement ok
ALTER TABLE t4_8049 ADD COLUMN id INT GENERATED BY DEFAULT AS IDENTITY;

query I
SELECT COUNT(*) FROM sys.dependencies d JOIN sys.ids i ON i.id = d.depend_id WHERE i.name = 't4_8049'
----
0

statement ok
INSERT INTO t4_8049(val) VALUES ('x');

query TI
SELECT val, id FROM t4_8049
----
x
1

statement ok
SELECT 1;
