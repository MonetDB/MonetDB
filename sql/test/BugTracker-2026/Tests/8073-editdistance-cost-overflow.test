statement error 22003!overflow in calculation
SELECT levenshtein('abcd', 'wxyz', 1073741824, 1073741824)

statement error 22003!overflow in calculation
SELECT levenshtein('abcd', 'wxyz', 2147483647, 2147483647)

# the BAT/filter path uses the same cost arithmetic
query I
SELECT COUNT(*) FROM (VALUES ('abcd', 'wxyz'), ('abc', 'abc')) AS t(a, b) WHERE maxlevenshtein(a, b, 10, 2147483646, 2147483646)
----
1
