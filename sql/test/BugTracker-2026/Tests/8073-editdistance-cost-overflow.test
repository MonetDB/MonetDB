# large edit-operation costs must not wrap while computing distances

query I
SELECT dameraulevenshtein('MonetDB', 'DB3', 4, 2, 1)
----
8

query I
SELECT dameraulevenshtein('MonetDB', 'DB3', 2147483641, 2, 1)
----
8

query I
SELECT dameraulevenshtein('MonetDB', 'DB3', 2147483642, 2, 1)
----
8

query I
SELECT dameraulevenshtein('MonetDB', 'DB3', 2147483646, 2, 1)
----
8

query I
SELECT dameraulevenshtein('MonetDB', 'DB3', 4, 2147483638, 1)
----
9

query I
SELECT dameraulevenshtein('MonetDB', 'DB3', 4, 2147483639, 1)
----
9

query I
SELECT dameraulevenshtein('ab', 'xy', 1, 1000, 1)
----
2

query I
SELECT dameraulevenshtein('ab', 'xy', 1, 2147483646, 1)
----
2

query I
SELECT levenshtein('MonetDB', 'DB3', 2147483646, 2, 1)
----
8

query I
SELECT levenshtein('MonetDB', 'DB3', 4, 2147483646, 1)
----
9

query I
SELECT levenshtein('abcd', 'wxyz', 1000, 1000)
----
4000

statement error 22003!overflow in calculation
