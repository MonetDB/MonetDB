-- Direct grouped subquery.
query I nosort
SELECT COUNT(*) AS cnt
FROM (
  SELECT c1, COUNT(DISTINCT c10) AS agg_cnt
  FROM t3
  GROUP BY c1
) AS s
----
3

-- CTAS form.
statement ok
CREATE TABLE tt AS
SELECT c1, COUNT(DISTINCT c10) AS agg_cnt
FROM t3
GROUP BY c1

query I nosort
SELECT COUNT(*) AS cnt
FROM tt
----
3

statement ok
DROP TABLE IF EXISTS tt

statement ok
DROP TABLE IF EXISTS t3

