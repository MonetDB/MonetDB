query I
SELECT COUNT(*) AS matched_rows
FROM l
WHERE EXISTS (
    SELECT 1
    FROM r
    WHERE r.i = l.i AND r.j > l.j
)
----
1337

query II
SELECT current_count - n AS leaked_physical_references,
       current_count - n = 0 AS oracle_no_leak
FROM matched_before,
     (SELECT COUNT(*) AS current_count
      FROM sys.bbp()
      WHERE refcnt > 0
        AND lrefcnt = 0
        AND kind = 'transient'
        AND ttype = 'oid'
        AND "count" = 1337) AS after_state
----
0	1

