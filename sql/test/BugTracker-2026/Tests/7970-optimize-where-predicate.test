statement ok
CREATE TABLE mre_a (
    x INTEGER
)

statement ok
CREATE TABLE mre_b (
    d DATE
)

statement ok
CREATE TABLE mre_c (
    x INTEGER
)

statement ok
INSERT INTO mre_a
SELECT value
FROM generate_series(1, 101)

statement ok
INSERT INTO mre_b
SELECT DATE '2025-01-01'
FROM generate_series(1, 101)

statement ok
INSERT INTO mre_c
SELECT value
FROM generate_series(1, 101)

-- Slow query: the predicate is applied above the LEFT JOIN.
query T nosort
EXPLAIN
SELECT c.x
FROM mre_a AS a
JOIN mre_b AS b ON TRUE
LEFT JOIN mre_c AS c ON TRUE
WHERE b.d BETWEEN '2023-01-01 00:00:00'
              AND '2023-12-31 23:59:59'
----
project (
| select (
| | left outer join (
| | | crossproduct (
| | | | table("sys"."mre_a") [ "mre_a"."%TID%" as "a"."%TID%" ],
| | | | table("sys"."mre_b") [ "mre_b"."d" as "b"."d" ]
| | | ) [  ],
| | | table("sys"."mre_c") [ "mre_c"."x" as "c"."x" ]
| | ) [  ]
| ) [ (date[varchar(19) "2023-01-01 00:00:00"]) <= ("b"."d") <= (date[varchar(19) "2023-12-31 23:59:59"]) ]
) [ "c"."x" ]

-- next query takes 0.401 secs
query I nosort
SELECT c.x
FROM mre_a AS a
JOIN mre_b AS b ON TRUE
LEFT JOIN mre_c AS c ON TRUE
WHERE b.d BETWEEN '2023-01-01 00:00:00'
              AND '2023-12-31 23:59:59'
----

-- Fast equivalent query: the WHERE predicate is redundantly repeated in ON.
query T nosort
EXPLAIN
SELECT c.x
FROM mre_a AS a
JOIN mre_b AS b
  ON b.d BETWEEN '2023-01-01 00:00:00'
             AND '2023-12-31 23:59:59'
LEFT JOIN mre_c AS c ON TRUE
WHERE b.d BETWEEN '2023-01-01 00:00:00'
              AND '2023-12-31 23:59:59'
----
project (
| select (
| | left outer join (
| | | select (
| | | | crossproduct (
| | | | | table("sys"."mre_a") [ "mre_a"."%TID%" as "a"."%TID%" ],
| | | | | table("sys"."mre_b") [ "mre_b"."d" as "b"."d" ]
| | | | ) [  ]
| | | ) [ (date[varchar(19) "2023-01-01 00:00:00"]) <= ("b"."d") <= (date[varchar(19) "2023-12-31 23:59:59"]) ],
| | | table("sys"."mre_c") [ "mre_c"."x" as "c"."x" ]
| | ) [  ]
| ) [ (date[varchar(19) "2023-01-01 00:00:00"]) <= ("b"."d") <= (date[varchar(19) "2023-12-31 23:59:59"]) ]
) [ "c"."x" ]

-- next query takes 0.014 secs, so 28 times faster than above query
query I nosort
SELECT c.x
FROM mre_a AS a
JOIN mre_b AS b
  ON b.d BETWEEN '2023-01-01 00:00:00'
             AND '2023-12-31 23:59:59'
LEFT JOIN mre_c AS c ON TRUE
WHERE b.d BETWEEN '2023-01-01 00:00:00'
              AND '2023-12-31 23:59:59'
----

statement ok
DROP TABLE IF EXISTS mre_c

statement ok
DROP TABLE IF EXISTS mre_b

statement ok
DROP TABLE IF EXISTS mre_a

