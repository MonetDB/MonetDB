CREATE TABLE p8068 (id INTEGER NOT NULL, k INTEGER NOT NULL)

statement ok
CREATE TABLE b8068 (k INTEGER NOT NULL)

statement ok rowcount 400000
INSERT INTO p8068 (id, k) SELECT CAST(value AS INTEGER) AS id, CAST(value AS INTEGER) AS k FROM sys.generate_series(1, 400001)

statement ok rowcount 400000
INSERT INTO b8068 (k) SELECT CAST(value AS INTEGER) FROM sys.generate_series(1, 400001)

statement ok
ANALYZE sys.p8068

statement ok
ANALYZE sys.b8068

query I
SELECT COUNT(DISTINCT p.id)
FROM (SELECT id, k FROM p8068 LIMIT 300000) p
JOIN (SELECT k FROM b8068 LIMIT 100000 OFFSET 200000) b
  ON p.k = b.k
----
100000

