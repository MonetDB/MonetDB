statement ok
CREATE SCHEMA test_schema

statement ok
CREATE SEQUENCE test_schema.myseq AS INTEGER

query T nosort
SELECT name FROM sys.schemas
 WHERE name = 'test_schema'
----
test_schema

query T nosort
SELECT name FROM sys.sequences
 WHERE name = 'myseq'
   AND schema_id IN (SELECT id FROM sys.schemas WHERE name = 'test_schema')
----
myseq

query I nosort
SELECT next_value_for('test_schema', 'myseq')
----
1

statement ok
ALTER SCHEMA "test_schema" RENAME TO "new_schema"

query T nosort
SELECT name FROM sys.schemas
 WHERE name IN ('test_schema', 'new_schema')
----
new_schema

query T nosort
SELECT name FROM sys.sequences
 WHERE name = 'myseq'
   AND schema_id IN (SELECT id FROM sys.schemas WHERE name = 'new_schema')
----
myseq

