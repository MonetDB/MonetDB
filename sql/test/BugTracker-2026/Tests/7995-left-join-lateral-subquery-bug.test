-- (A) Correct row listing: (1,1),(2,0),(3,0) — three rows
-- observed: (1,1), (2,0), (3,0)   correct
query II rowsort
SELECT r0.id, l.n
FROM n5a r0
LEFT JOIN LATERAL (SELECT COUNT(*) AS n FROM n5b r1 WHERE r1.c0 = r0.c0) l ON TRUE
ORDER BY r0.id
----
1
1
2
0
3
0

-- (B) COUNT(*) over the SAME join: expected 3, get 4
-- observed: 4   WRONG (11.55.5 returns 3)
query I rowsort
SELECT COUNT(*)
FROM n5a r0
LEFT JOIN LATERAL (SELECT COUNT(*) AS n FROM n5b r1 WHERE r1.c0 = r0.c0) l ON TRUE
----
3

-- (C) Projecting id alone: the NULL-correlated outer row (id=2) is duplicated
-- observed: 1, 2, 2, 3   WRONG (11.55.5 returns 1, 2, 3)
query I rowsort
SELECT r0.id
FROM n5a r0
LEFT JOIN LATERAL (SELECT COUNT(*) AS n FROM n5b r1 WHERE r1.c0 = r0.c0) l ON TRUE
ORDER BY r0.id
----
1
2
3

