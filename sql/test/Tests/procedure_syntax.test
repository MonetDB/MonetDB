-- test  CREATE OR REPLACE  and  IF NOT EXISTS variants
statement ok
create table t1 (id int)

statement ok
create or replace PROCEDURE p1(id int) BEGIN insert into t1 values(id); END

statement ok
CALL p1(10);

statement error 42000!CREATE PROCEDURE: name 'p1' (int) already in use
create PROCEDURE p1(id int) BEGIN insert into t1 values(id +1); END

statement ok
CALL p1(10);

statement ok
create PROCEDURE IF NOT EXISTS p1(id int) BEGIN insert into t1 values(id +2); END

statement ok
CALL p1(10);

statement ok
create or replace PROCEDURE p1(id int) BEGIN insert into t1 values(id +3); END

statement ok
CALL p1(10);

statement error 42000!Syntax error: CREATE OR REPLACE PROCEDURE in combination with IF NOT EXISTS is not allowed
create or replace PROCEDURE IF NOT EXISTS p1(id int) BEGIN insert into t1 values(id +4); END

statement ok
CALL p1(10);

