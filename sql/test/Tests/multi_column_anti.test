statement ok
start transaction;

statement ok
create table l (id int, a int, b int, c int);

statement ok
insert into l values
	(0, null,    2,    7),
	(1, null,    3,    6),
	(2,    2, null,    7),
	(3,    2, null,    6),
	(4,    3,    3, null),
	(5,    3,    4, null);

statement ok
create table r (id int, x int, y int, z int);

statement ok
insert into r values
	(0,    1,    1,    5),
	(1, null,    1,    5),
	(2,    2,    2,    7),
	(3,    2,    3,    8),
	(4,    3,    3,    4),
	(5, null,    3,    6);

query IIII nosort
select * from l where (a,b,c) not in (select x, y, z from r);
